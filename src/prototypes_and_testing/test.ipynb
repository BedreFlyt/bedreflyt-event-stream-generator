   "source": [
    "import numpy as np\n",
    "from numpy import random\n",
    "\n",
    "def get_random_normal_geq_0 (o, v):\n",
    "    s = round(random.normal(loc=o, scale=v))\n",
    "    print(s)\n",
    "    if s < 0: return 0\n",
    "    else: return s\n",
    "\n",
    "for e in np.linspace(0, 10, 100):\n",
    "    print(get_random_normal_ge_0(e, .5))\n",
    "\n"
   ]
  }
